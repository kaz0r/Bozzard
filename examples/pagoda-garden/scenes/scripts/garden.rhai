// Generated by tools/gen_pagoda.py. Space or N toggles night; lanterns flicker.

fn apply_daylight(night) {
    if night {
        set_sun_light([0.346704, 0.456411, 1.0], 0.18);
        set_ambient_light([0.158961, 0.238398, 0.57758], 0.03);
        set_environment([0.003347, 0.006995, 0.029557], [0.006049, 0.01033, 0.033105], [0.006049, 0.01033, 0.033105], 0.6);
        set_star_intensity(1.5);
        set_fog([0.006049, 0.01033, 0.033105], 0.008);
        set_bloom_intensity(0.5);
    } else {
        set_sun_light([1.0, 0.887923, 0.686685], 1.35);
        set_ambient_light([1.0, 1.0, 1.0], 0.057);
        set_environment([0.520996, 0.768151, 1.0], [0.341914, 0.584078, 0.871367], [0.341914, 0.584078, 0.871367], 1.0);
        set_star_intensity(0.0);
        set_fog([0.341914, 0.584078, 0.871367], 0.008);
        set_bloom_intensity(0.12);
    }
}

fn on_update(me, dt) {
    let night = get_object_variable("night");
    if input_pressed("N") || input_pressed("Space") {
        night = !night;
        set_object_variable("night", night);
        apply_daylight(night);
    }
    let t = elapsed_time();
    let lantern = if night { 30.0 } else { 6.0 };
    let i = 0.0;
    for name in ["ac-light-lantern-0", "ac-light-lantern-1", "ac-light-lantern-2", "ac-light-lantern-3"] {
        set_light_intensity(name, lantern * (1.0 + 0.18 * sin(t * 3.0 + i) + random(0.0, 0.08)));
        i += 1.0;
    }
    let pond = if night { 20.0 } else { 4.5 };
    set_light_intensity("ac-light-pond", pond * (1.0 + 0.12 * sin(t * 1.4)));
}
