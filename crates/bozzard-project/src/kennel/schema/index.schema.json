{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Bozzard-Engine/bozzard-plugin-library/main/schema/index.schema.json",
  "title": "Kennel registry index",
  "description": "Generated by `bozzard-project kennel index`; do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kennel", "packages"],
  "properties": {
    "$schema": { "type": "string" },
    "kennel": { "const": 1 },
    "packages": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": { "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "title", "summary", "category", "manifest", "sha256"],
      "properties": {
        "version": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "category": { "enum": ["integration", "scripts", "art", "audio", "template", "tool"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "manifest": { "type": "string", "description": "packages/<name>/<name>.pkg.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the manifest file." }
      }
    }
  }
}
